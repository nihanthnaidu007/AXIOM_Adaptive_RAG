# AXIOM backend environment — copy to backend/.env and fill in every value.
# Generate strong random strings for API_KEY, POSTGRES_PASSWORD, REDIS_PASSWORD.

# --- Fail-closed auth ------------------------------------------------------
# X-API-Key value required by every protected endpoint. No default: without
# it the API refuses protected requests.
API_KEY=change-me-strong-random

# --- Model keys ------------------------------------------------------------
# Keys are demanded only from the seams that call cloud APIs (see below):
# cloud mode requires them; fully-local mode does not.
ANTHROPIC_API_KEY=sk-ant-...
# Embeddings + optional web-search fallback
OPENAI_API_KEY=sk-...
# Optional: web search when local retrieval is weak
TAVILY_API_KEY=

# --- Provider modes (Wave 3: fully-local) ----------------------------------
# "cloud" (default) = Anthropic generation + OpenAI embeddings, unchanged for
# existing deployments. "local" = Ollama for that seam. Fully-local sets BOTH
# to local: a local generator with cloud embeddings would keep a hard cloud
# dependency (and a required API key) inside a mode claiming local operation.
LLM_PROVIDER=cloud
EMBEDDING_PROVIDER=cloud
# Ollama endpoint + models. The generator model defaults distinct from the
# critic model so critic != generator by default (same-model self-grading
# correlates errors; equal settings are allowed but carry that caveat).
OLLAMA_HOST=http://localhost:11434
OLLAMA_GENERATION_MODEL=llama3.1:8b
OLLAMA_CRITIC_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Native width of the local embedding model. Owned in code: Ollama's
# OpenAI-compat layer ignores OpenAI's `dimensions` kwarg. Switching the
# embedding provider changes the vector width — `alembic upgrade head`
# rebuilds chunk_embeddings (old rows are parked in a backup table), then
# `python -m axiom.reembed` restores them from stored content.
LOCAL_EMBEDDING_DIMENSIONS=768

# --- PostgreSQL (pgvector) -------------------------------------------------
# Async engine (migrations + app I/O). The app rewrites the legacy
# postgres:// form to the async driver automatically.
DATABASE_URL=postgresql+asyncpg://axiom:axiom_password@localhost:5432/axiom_rag
# Sync legacy form used by some tools; keep in sync with DATABASE_URL.
POSTGRES_URL=postgresql://axiom:axiom_password@localhost:5432/axiom_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=axiom
POSTGRES_PASSWORD=axiom_password
POSTGRES_DB=axiom_rag
# Apply `alembic upgrade head` at startup (single schema source).
RUN_MIGRATIONS_ON_STARTUP=true

# --- Redis (semantic cache) ------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Observability (Wave 2) -----------------------------------------------
# json = one JSON object per log line (production); text = human-readable.
LOG_FORMAT=json
LOG_LEVEL=INFO
