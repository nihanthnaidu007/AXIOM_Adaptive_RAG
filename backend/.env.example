# AXIOM backend environment — copy to backend/.env and fill in every value.
# Generate strong random strings for API_KEY, POSTGRES_PASSWORD, REDIS_PASSWORD.

# --- Fail-closed auth ------------------------------------------------------
# X-API-Key value required by every protected endpoint. No default: without
# it the API refuses protected requests.
API_KEY=change-me-strong-random

# --- Model keys ------------------------------------------------------------
# Keys are demanded only from the seams that call cloud APIs (see below):
# cloud mode requires them; fully-local mode does not.
ANTHROPIC_API_KEY=sk-ant-...
# Embeddings + optional web-search fallback
OPENAI_API_KEY=sk-...
# Optional: web search when local retrieval is weak
TAVILY_API_KEY=

# --- Provider modes (Wave 3: fully-local) ----------------------------------
# "cloud" (default) = Anthropic generation + OpenAI embeddings, unchanged for
# existing deployments. "local" = Ollama for that seam. Fully-local sets BOTH
# to local: a local generator with cloud embeddings would keep a hard cloud
# dependency (and a required API key) inside a mode claiming local operation.
LLM_PROVIDER=cloud
EMBEDDING_PROVIDER=cloud
# Ollama endpoint + models. The generator model defaults distinct from the
# critic model so critic != generator by default (same-model self-grading
# correlates errors; equal settings are allowed but carry that caveat).
OLLAMA_HOST=http://localhost:11434
OLLAMA_GENERATION_MODEL=llama3.1:8b
OLLAMA_CRITIC_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Native width of the local embedding model. Owned in code: Ollama's
# OpenAI-compat layer ignores OpenAI's `dimensions` kwarg. Switching the
# embedding provider changes the vector width — there is NO automatic
# migration or backup restore: `python -m axiom.reembed --yes` TRUNCATES
# chunk_embeddings and clears ingested_documents, so re-ingest every source
# (re-upload files or re-run the S3/web connectors) afterwards.
LOCAL_EMBEDDING_DIMENSIONS=768

# --- PostgreSQL (pgvector) -------------------------------------------------
# Async engine (migrations + app I/O). The app rewrites the legacy
# postgres:// form to the async driver automatically.
DATABASE_URL=postgresql+asyncpg://axiom:axiom_password@localhost:5432/axiom_rag
# Sync legacy form used by some tools; keep in sync with DATABASE_URL.
POSTGRES_URL=postgresql://axiom:axiom_password@localhost:5432/axiom_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=axiom
POSTGRES_PASSWORD=axiom_password
POSTGRES_DB=axiom_rag
# Apply `alembic upgrade head` at startup (single schema source).
RUN_MIGRATIONS_ON_STARTUP=true

# --- Redis (semantic cache) ------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Observability (Wave 2) -----------------------------------------------
# json = one JSON object per log line (production); text = human-readable.
LOG_FORMAT=json
LOG_LEVEL=INFO

# --- OCR / table parsing (Wave 4, optional extra) ---------------------------
# Scanned PDFs fail visibly by default: they cannot be indexed without OCR.
# OCR_ENABLED=true switches parse_document to the Docling adapter, which
# requires the optional extra:  pip install '.[ocr]'  (large dependency tree;
# pdfplumber remains the default for digital PDFs either way).
OCR_ENABLED=false
# Below this text-layer char/page threshold a PDF counts as "scanned".
OCR_MIN_TEXT_CHARS_PER_PAGE=32
# Whole-document character budget for Docling conversion (per file).
OCR_MAX_CHARS=2000000

# --- S3 connector (Wave 4, optional) ----------------------------------------
# One bucket per run; absent S3_BUCKET leaves the connector disabled (the API
# answers 503 on an explicit run request). Credentials fall back to the
# standard AWS chain; S3_ENDPOINT_URL targets MinIO/other S3-compatible stores.
S3_BUCKET=
S3_PREFIX=
S3_RECURSIVE=true
S3_MAX_OBJECT_SIZE_MB=25
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# --- Web-crawl connector (Wave 4, optional) ---------------------------------
# Comma-separated http(s) seed URLs; empty disables the connector. Crawling is
# same-host BFS with robots.txt honored by default, per-host rate limiting,
# page/depth/byte caps, and fetch-time dedup in Redis (axiom:crawl:*).
CRAWL_SEEDS=
CRAWL_MAX_PAGES=25
CRAWL_MAX_DEPTH=2
CRAWL_RATE_LIMIT_SECONDS=1.0
CRAWL_RESPECT_ROBOTS=true
CRAWL_MAX_PAGE_BYTES=2000000

# --- Connector runs (Wave 4) -------------------------------------------------
# In-memory run records past the retention window are pruned; completed runs
# disappear from the polling endpoint after this many seconds.
CONNECTOR_RUN_RETENTION_SECONDS=3600
